{
  "name": "@open-software-factory/osf-opencode-plugin",
  "version": "0.1.0",
  "description": "Reports the osf writing check after every OpenCode turn, by reading the session's last assistant message",
  "repository": { "type": "git", "url": "git+https://github.com/open-software-factory/software-factory.git", "directory": "integrations/opencode" },
  "homepage": "https://github.com/open-software-factory/software-factory",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run check:types && pnpm run check:lint && pnpm run check:format",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:lint": "oxlint -D correctness -D suspicious -D pedantic --deny-warnings src test",
    "check:format": "oxfmt --check src test",
    "format": "oxfmt src test",
    "pretest": "pnpm run build",
    "test": "node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@types/node": "26.6.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  }
}
