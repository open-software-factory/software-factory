{
  "name": "@open-software-factory/osf-omp-hook",
  "version": "0.1.0",
  "description": "Runs the osf writing check at the end of every omp turn, reading the assistant message from the session_stop event",
  "repository": { "type": "git", "url": "git+https://github.com/open-software-factory/software-factory.git", "directory": "integrations/omp" },
  "homepage": "https://github.com/open-software-factory/software-factory",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "main": "dist/src/osf-stop.js",
  "files": ["dist/"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "pretest": "npm run build",
    "test": "node --test dist/test/**/*.test.js"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.2.4",
    "@types/node": "26.6.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  }
}
